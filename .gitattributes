# Configuração de quebras de linha para diferentes tipos de arquivo
* text=auto

# Arquivos de código fonte - sempre LF
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.sql text eol=lf

# Scripts Unix - sempre LF
mvnw text eol=lf
*.sh text eol=lf

# Scripts Windows - sempre CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Arquivos binários
*.jar binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
